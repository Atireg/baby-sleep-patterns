// Paste into Firebase console → Firestore Database → Rules, replace the example
// addresses with the family's Google accounts, then Publish.
// Keep the real addresses out of this public repository.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['parent1@gmail.com', 'parent2@gmail.com'];
    }
  }
}
